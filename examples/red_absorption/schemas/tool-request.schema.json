{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "atomic_number", "isotope", "formal_charge", "radical_electrons", "chiral_tag", "chiral_neighbor_atom_ids", "explicit_h_count", "no_implicit", "aromatic", "atom_map"],
      "properties": {
        "atom_id": {"type": "string"}, "atomic_number": {"type": "integer"},
        "isotope": {"type": "integer"}, "formal_charge": {"type": "integer"},
        "radical_electrons": {"type": "integer"}, "chiral_tag": {"type": "string"},
        "chiral_neighbor_atom_ids": {"type": "array", "items": {"type": "string"}},
        "explicit_h_count": {"type": "integer"}, "no_implicit": {"type": "boolean"},
        "aromatic": {"type": "boolean"}, "atom_map": {"type": ["integer", "null"]}
      }
    },
    "bond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bond_id", "begin_atom_id", "end_atom_id", "bond_type", "aromatic", "conjugated", "stereo", "stereo_atom_ids", "bond_direction"],
      "properties": {
        "bond_id": {"type": "string"}, "begin_atom_id": {"type": "string"},
        "end_atom_id": {"type": "string"}, "bond_type": {"type": "string"},
        "aromatic": {"type": "boolean"}, "conjugated": {"type": "boolean"},
        "stereo": {"type": "string"},
        "stereo_atom_ids": {"type": "array", "items": {"type": "string"}},
        "bond_direction": {"type": "string"}
      }
    },
    "chemicalGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "atoms", "bonds", "total_charge", "multiplicity", "chemical_identity_hash", "state_hash", "parent_state_hash", "next_atom_serial", "next_bond_serial", "geometry_status", "committed_commands"],
      "properties": {
        "schema_version": {"type": "string", "const": "molecule-editor:chemical-graph:v1"},
        "atoms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/atom"}},
        "bonds": {"type": "array", "items": {"$ref": "#/$defs/bond"}},
        "total_charge": {"type": "integer"}, "multiplicity": {"type": "integer"},
        "chemical_identity_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_state_hash": {"type": ["string", "null"]},
        "next_atom_serial": {"type": "integer"}, "next_bond_serial": {"type": "integer"},
        "geometry_status": {"enum": ["NOT_REQUESTED", "READY", "FAILED"]},
        "committed_commands": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization_id", "provider", "operation", "tool_payload"],
  "properties": {
    "authorization_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"type": "string", "const": "molecule_editor"},
    "operation": {"type": "string", "const": "edit"},
    "tool_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspected_source_hash", "commands"],
      "properties": {
        "inspected_source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commands": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {"anyOf": [
            {"type": "object", "additionalProperties": false, "required": ["operation", "atom_id", "atomic_number", "isotope", "formal_charge", "chiral_tag", "explicit_h_count", "no_implicit", "aromatic", "atom_map"], "properties": {"operation": {"type": "string", "const": "replace_atom"}, "atom_id": {"type": "string"}, "atomic_number": {"type": "integer"}, "isotope": {"type": ["integer", "null"]}, "formal_charge": {"type": ["integer", "null"]}, "chiral_tag": {"type": ["string", "null"]}, "explicit_h_count": {"type": ["integer", "null"]}, "no_implicit": {"type": ["boolean", "null"]}, "aromatic": {"type": ["boolean", "null"]}, "atom_map": {"type": ["integer", "null"]}}},
            {"type": "object", "additionalProperties": false, "required": ["operation", "bond_id", "bond_type", "aromatic", "conjugated", "stereo", "stereo_atom_ids", "bond_direction"], "properties": {"operation": {"type": "string", "const": "change_bond"}, "bond_id": {"type": "string"}, "bond_type": {"type": "string"}, "aromatic": {"type": ["boolean", "null"]}, "conjugated": {"type": ["boolean", "null"]}, "stereo": {"type": ["string", "null"]}, "stereo_atom_ids": {"type": ["array", "null"], "items": {"type": "string"}}, "bond_direction": {"type": ["string", "null"]}}},
            {"type": "object", "additionalProperties": false, "required": ["operation", "anchor_atom_id", "fragment_graph", "fragment_anchor_atom_id", "bond_type", "client_ref"], "properties": {"operation": {"type": "string", "const": "attach_fragment"}, "anchor_atom_id": {"type": "string"}, "fragment_graph": {"$ref": "#/$defs/chemicalGraph"}, "fragment_anchor_atom_id": {"type": "string"}, "bond_type": {"type": "string"}, "client_ref": {"type": ["string", "null"]}}},
            {"type": "object", "additionalProperties": false, "required": ["operation", "bond_id", "retained_atom_id", "fragment_graph", "fragment_anchor_atom_id", "bond_type", "client_ref"], "properties": {"operation": {"type": "string", "const": "substitute_fragment"}, "bond_id": {"type": "string"}, "retained_atom_id": {"type": "string"}, "fragment_graph": {"$ref": "#/$defs/chemicalGraph"}, "fragment_anchor_atom_id": {"type": "string"}, "bond_type": {"type": "string"}, "client_ref": {"type": ["string", "null"]}}}
          ]}
        }
      }
    }
  }
}
